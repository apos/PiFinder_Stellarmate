[Unit]
Description=PiFinder
After=basic.target pifinder-setup.service
Requires=pifinder-setup.service
# The Waveshare LCD dev overlay (waveshare35b-v2, toggled via the Control
# Center's "Turn LCD On/Off" button) claims GPIO lines the real HAT's OLED
# needs too - starting anyway crashes on 'lgpio.error: GPIO not allocated'.
# /dev/fb1 only exists when that overlay is active, so skip cleanly (not a
# failure - systemd logs a condition-check skip, not a crash) instead of
# starting and immediately dying. See basic-memory/pifinder-stellarmate/
# 00024 and 00030.
ConditionPathExists=!/dev/fb1

[Service]
Type=idle
User=stellarmate
WorkingDirectory=/home/stellarmate/PiFinder/python
ExecStart=/home/stellarmate/PiFinder/python/.venv/bin/python -m PiFinder.main --verbose
ExecStopPost=/home/stellarmate/PiFinder/python/.venv/bin/python /home/stellarmate/PiFinder_Stellarmate/bin/display_off.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
SupplementaryGroups=kmem gpio spi i2c video input
# A cold boot can lose the PWM sysfs permission race (see main_py.diff's
# init_keypad_pwm retry) badly enough to still crash once; self-heal instead
# of staying "failed" until someone notices and restarts it by hand.
Restart=on-failure
RestartSec=2
# Mild deprioritization, not a hard cap: PiFinder's own solver spawns a CPU-
# hungry worker pool (found live 2026-08-03 investigating #139 - a 4-core
# Pi 4 hit load average 9+ with 10+ solver workers running, and pos_server.py's
# LX200 socket went genuinely unresponsive to :GR#/:GD# for several seconds
# at a time as a result, independent of anything the INDI driver does - see
# #148 for the more precise upstream fix this doesn't replace). Nice=5 and a
# below-default CPUWeight ask the scheduler to favor everything else (Control
# Center, indiserver, the OS itself) when the CPU is actually contended,
# without capping PiFinder below full-core use whenever it isn't.
Nice=5
CPUWeight=50

[Install]
WantedBy=basic.target
