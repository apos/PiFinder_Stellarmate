 logger = logging.getLogger("PiFinderAPI")
 
 
+def _angular_separation_deg(ra1, dec1, ra2, dec2) -> float:
+    """Great-circle separation in degrees between two J2000 RA/Dec points
+    (both in degrees). Standard haversine form - no existing helper for
+    this in calc_utils.py/catalogs.py to reuse."""
+    ra1_r, dec1_r, ra2_r, dec2_r = (math.radians(x) for x in (ra1, dec1, ra2, dec2))
+    d_ra = ra2_r - ra1_r
+    d_dec = dec2_r - dec1_r
+    a = (
+        math.sin(d_dec / 2) ** 2
+        + math.cos(dec1_r) * math.cos(dec2_r) * math.sin(d_ra / 2) ** 2
+    )
+    return math.degrees(2 * math.asin(min(1.0, math.sqrt(a))))
+
+
+# #191: 90-degree azimuth quadrants for /api/nearby_bright_stars' optional
+# `direction` filter - N straddles the 0/360 wrap, the other three don't.
+_DIRECTION_QUADRANTS = {
+    "N": (315.0, 45.0),
+    "E": (45.0, 135.0),
+    "S": (135.0, 225.0),
+    "W": (225.0, 315.0),
+}
+
+
+def _azimuth_in_direction(az: float, direction: str) -> bool:
+    lo, hi = _DIRECTION_QUADRANTS[direction]
+    if lo < hi:
+        return lo <= az < hi
+    return az >= lo or az < hi  # wraps through 0/360 (N only)
+
