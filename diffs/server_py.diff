+        @app.route("/api/set_mount_type", methods=["POST"])
+        def api_set_mount_type():
+            # Called by the PiFinder Mount Bridge INDI driver (StellarMate
+            # integration) to keep PiFinder's own Mount Type setting in sync
+            # with whatever real INDI mount is currently connected. Local
+            # machine-to-machine call, not a browser session - no @auth_required,
+            # restricted to loopback instead.
+            if request.remote_addr not in ("127.0.0.1", "::1"):
+                return jsonify({"error": "forbidden"}), 403
+
+            payload = request.get_json(silent=True) or {}
+            mount_type = request.form.get("mount_type") or payload.get("mount_type")
+            if mount_type not in ("EQ", "Alt/Az"):
+                return jsonify({"error": "mount_type must be 'EQ' or 'Alt/Az'"}), 400
+
+            cfg = config.Config()
+            cfg.load_config()
+            cfg.set_option("mount_type", mount_type)
+            self.ui_queue.put("reload_config")
+            return jsonify({"ok": True, "mount_type": mount_type})
+
+        @app.route("/api/orientation_status")
+        def api_orientation_status():
+            # Read-only counterpart to /api/set_mount_type above - lets the
+            # Mount Bridge INDI driver (StellarMate integration) show both of
+            # PiFinder's own IMU-dead-reckoning-relevant settings (Mount Type
+            # and PiFinder Type/screen_direction, Settings -> Advanced ->
+            # PiFinder Type) as status badges, without needing to guess them
+            # from config.json directly. Same loopback-only restriction as
+            # /api/set_mount_type - machine-to-machine, not a browser session.
+            if request.remote_addr not in ("127.0.0.1", "::1"):
+                return jsonify({"error": "forbidden"}), 403
+
+            cfg = config.Config()
+            cfg.load_config()
+            return jsonify(
+                {
+                    "mount_type": cfg.get_option("mount_type"),
+                    "screen_direction": cfg.get_option("screen_direction"),
+                }
+            )
+
+        @app.route("/api/hardware_status")
+        def api_hardware_status():
+            # Read-only host/hardware facts for the PiFinder LX200 INDI
+            # driver (StellarMate integration) to expose as its own
+            # properties - so a remote Control Center (and any other INDI
+            # client: EKOS, the StellarMate App, ...) can see this device's
+            # Camera/IMU presence, CPU load/temp and Mount Type/Screen
+            # Direction without a separate, auth-protected Control-Center-
+            # to-Control-Center call. Open like /api/status and
+            # /api/current_target above - these are non-sensitive host facts,
+            # not a mutation, so no loopback restriction like
+            # /api/set_mount_type's above.
+            camera_present = None
+            try:
+                result = subprocess.run(
+                    ["rpicam-hello", "--list-cameras"],
+                    capture_output=True, text=True, timeout=25,
+                )
+                camera_present = "No cameras available" not in result.stdout
+            except Exception:
+                pass
+
+            # BNO055 (the IMU PiFinder uses) answers on I2C address 0x28, or
+            # 0x29 if its ADR pin is pulled high. A fresh board.I2C() handle
+            # here (not imu_pi.py's own, already-open one - that process
+            # holds it continuously) can occasionally race a concurrent
+            # transaction from imu_pi.py's own ~30Hz polling and come back
+            # empty - retry a couple of times before concluding "not
+            # present", same reasoning as any other shared, non-exclusive
+            # I2C bus scan.
+            imu_present = None
+            try:
+                import board  # noqa: PLC0415 - optional hardware dep, only needed here
+
+                i2c = board.I2C()
+                for attempt in range(3):
+                    if not i2c.try_lock():
+                        imu_present = None
+                        break
+                    try:
+                        addrs = {hex(a) for a in i2c.scan()}
+                    finally:
+                        i2c.unlock()
+                    if addrs & {"0x28", "0x29"}:
+                        imu_present = True
+                        break
+                    imu_present = False
+                    if attempt < 2:
+                        time.sleep(0.3)
+            except Exception:
+                imu_present = None
+
+            load1, load5, load15 = os.getloadavg()
+            cpu_count = os.cpu_count() or 1
+            temp_c = None
+            try:
+                with open("/sys/class/thermal/thermal_zone0/temp") as f:
+                    temp_c = round(int(f.read().strip()) / 1000, 1)
+            except Exception:
+                pass
+
+            cfg = config.Config()
+            cfg.load_config()
+            return jsonify(
+                {
+                    "camera_present": camera_present,
+                    "imu_present": imu_present,
+                    "load1": round(load1, 2),
+                    "load5": round(load5, 2),
+                    "load15": round(load15, 2),
+                    "cpu_count": cpu_count,
+                    "percent": round((load1 / cpu_count) * 100),
+                    "temp_c": temp_c,
+                    "mount_type": cfg.get_option("mount_type"),
+                    "screen_direction": cfg.get_option("screen_direction"),
+                }
+            )
+
+        @app.route("/api/keep_awake", methods=["POST"])
+        def api_keep_awake():
+            # Called repeatedly (every ~2s) by the Mount Bridge INDI driver
+            # (StellarMate integration) while GoTo-Forward mode is actively
+            # coordinating a GoTo - that mode needs full-cadence, fresh
+            # solves to Sync from and to verify arrival against, but
+            # PiFinder's own battery-friendly sleep (keypad/IMU activity
+            # only, see PowerManager in main.py) has no way to know an
+            # external caller needs it awake. A single call only buys
+            # PowerManager._EXTERNAL_ACTIVITY_GRACE_SEC worth of "activity" -
+            # callers must keep polling for as long as they need this. Same
+            # loopback-only restriction as /api/set_mount_type - machine-to-
+            # machine, not a browser session.
+            if request.remote_addr not in ("127.0.0.1", "::1"):
+                return jsonify({"error": "forbidden"}), 403
+
+            self.shared_state.register_external_activity()
+            return jsonify({"ok": True})
