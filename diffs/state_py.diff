+    def set_last_align(self, ra: float, dec: float) -> None:
+        """Record a confirmed solve-based PiFinder Align. ``ra``/``dec`` are
+        the J2000 catalog coordinates (degrees) of the object the user just
+        centered in the telescope's own eyepiece - i.e. where the telescope
+        is now known to be truly pointed. Called only from
+        ``ui/align.py::align_on_radec()`` on success, so every real align
+        entry point (the Align screen, "align on this object" from the
+        object list) is covered while the non-solve paths (reset-to-center,
+        manual daytime align) are not. Stamps all three fields together so a
+        reader never sees a fresh timestamp with stale coordinates.
+        """
+        self.__last_align_ra = float(ra)
+        self.__last_align_dec = float(dec)
+        self.__last_align_time = time.time()
+
     def sats(self):
