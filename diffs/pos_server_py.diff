+# Connection-admission guard for run_server()'s accept loop (2026-09-05, same
+# concept doc as above) - found live that a naive "thread per accept()" would
+# turn a misbehaving client stuck in a reconnect loop (app relaunch, flaky
+# wifi) into unbounded thread/socket/shared_state-Manager-connection growth.
+#
+# Live-tested (2026-09-05) and deliberately simplified from an earlier draft:
+# that draft ALSO proactively closed an "old" connection from the same IP
+# arriving within a short debounce window, on the assumption that meant the
+# same client reconnecting. A real test with two independent local clients
+# (both from 127.0.0.1 - exactly how `indi_pifinder_lx200` itself connects,
+# and a plausible setup if e.g. Stellarium also runs on the same host)
+# immediately showed why that assumption is wrong: multiple genuinely
+# distinct clients CAN share one IP, and closing one of them to make room
+# for the other is a real regression, not a safety feature. Removed. What's
+# left is a purely passive cap - it never closes an existing connection,
+# only refuses a NEW one once a limit is already reached. A stale connection
+# from a client that reconnected without closing its old socket cleans
+# itself up the same way it always did: the client's own TCP stack usually
+# sends a RST (handled already, s. ConnectionResetError below), and failing
+# that, the existing 60s socket timeout.
+MAX_CONNECTIONS_PER_IP = 3
+MAX_TOTAL_CONNECTIONS = 8
+CONNECTION_LIMIT_WARN_INTERVAL_SEC = 45
+
+_connections_lock = threading.Lock()
+_open_sockets_by_ip: dict = {}  # ip -> list[socket.socket]
+_last_limit_warn_time = 0.0
+
+
+def _admit_connection(client_socket: socket.socket, address) -> bool:
+    """Runs in run_server()'s accept thread, before a client thread is
+    started. Returns True if client_socket should be served (a thread
+    started for it); on False, the caller must close client_socket itself -
+    this function never closes a socket other than the one it was asked
+    about."""
+    global _last_limit_warn_time
+    ip = address[0]
+
+    with _connections_lock:
+        per_ip = _open_sockets_by_ip.setdefault(ip, [])
+        total_open = sum(len(v) for v in _open_sockets_by_ip.values())
+        if len(per_ip) >= MAX_CONNECTIONS_PER_IP or total_open >= MAX_TOTAL_CONNECTIONS:
+            now = time.monotonic()
+            if (now - _last_limit_warn_time) >= CONNECTION_LIMIT_WARN_INTERVAL_SEC:
+                _last_limit_warn_time = now
+                logger.warning(
+                    "Refusing connection from %s: %d/%d per-IP or %d/%d total connections already open.",
+                    ip,
+                    len(per_ip),
+                    MAX_CONNECTIONS_PER_IP,
+                    total_open,
+                    MAX_TOTAL_CONNECTIONS,
+                )
+            return False
+
+        per_ip.append(client_socket)
+        return True
+
+
+def _release_connection(client_socket: socket.socket, address) -> None:
+    """Companion to _admit_connection() - called from handle_client()'s
+    finally block so a closed connection's slot is freed for the caps above."""
+    ip = address[0]
+    with _connections_lock:
