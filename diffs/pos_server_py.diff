+def _call_with_timeout(fn, timeout: float = STATE_CALL_TIMEOUT_SEC):
+    """Calls a zero-arg shared_state accessor with a bounded timeout instead
+    of the default unbounded block. On timeout, returns None: the exact same
+    "nothing to report yet" value get_telescope_ra()/get_telescope_dec()
+    already return when there is no solution, which handle_client() already
+    sends nothing back for (a genuine communication failure to the client,
+    not a fake coordinate - see get_telescope_ra()'s own #107 comment) - no
+    new response type, just an additional, already-safe trigger for it.
+    Deliberately NOT a shared ThreadPoolExecutor (an earlier version of this
+    fix used one, sized max_workers=2..8) - with each client already on its
+    own thread (see module comment above), a shared pool just adds a second,
+    independently-sized capacity limit that can itself become a bottleneck.
+    A fresh daemon thread per call needs no sizing: the number of
+    concurrently in-flight calls is already bounded by the connection caps
+    in _admit_connection() below. The abandoned call keeps running in its
+    own thread if it times out; its eventual result is simply discarded."""
+    result: dict = {}
+
+    def _run():
+        try:
+            result["value"] = fn()
+        except Exception:
+            logger.exception("shared_state call raised")
+
+    call_thread = threading.Thread(target=_run, daemon=True)
+    call_thread.start()
+    call_thread.join(timeout)
+    if call_thread.is_alive():
+        logger.warning(
+            "shared_state call timed out after %.1fs - reporting no data for this request.",
+            timeout,
+        )
+        return None
+    return result.get("value")
+
