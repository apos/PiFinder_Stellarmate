+def _valid_imu_anchor(imu_sample) -> Optional[quaternion.quaternion]:
+    """Extract a usable anchor quaternion from an IMU sample, or None.
+
+    A degenerate anchor (missing sample, NaN quaternion, or a
+    near-zero-magnitude quaternion) breaks dead-reckoning silently
+    downstream: ``ImuDeadReckoning.solve()`` no-ops on a NaN
+    ``q_x2imu``, and ``.normalized()`` on a zero-magnitude quaternion
+    produces NaN - either way ``is_initialized()`` stays False forever
+    until the next anchor, with nothing in the log to explain why.
+    Found live: a fake-solve injection went through with exactly this
+    kind of anchor and dead-reckoning never engaged for the rest of
+    the session. Validate here so the caller can retry / warn instead.
+    """
+    if imu_sample is None:
+        return None
+    q = imu_sample.quat
+    if math.isnan(q.w) or math.isnan(q.x) or math.isnan(q.y) or math.isnan(q.z):
+        return None
+    if abs(q) < 1e-6:
+        return None
+    return q
+
+# Fake-solve simulation (see fake_solve_active): angular *rate* (not
+# cumulative angle) above which the telescope is considered "being
+# moved by hand", below which it's "settled" - mimics a real solve
+# landing right after a user stops slewing. Needs real-world tuning;
+# picked to sit clearly above hand-tremor/sensor-noise rates and
+# clearly below even a slow deliberate pan.
+FAKE_SOLVE_SETTLE_RATE_THRESHOLD = np.deg2rad(2.0)  # rad/s
