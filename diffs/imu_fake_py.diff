+        timestamp=0.0,
+        status=0,
+        moving=False,
+    )
     while True:
         imu.update()
+        imu_sample.status = imu.calibration
+        imu_sample.gyro = imu.gyro
+        imu_sample.accel = imu.accel
+        if imu.last_read_time:
