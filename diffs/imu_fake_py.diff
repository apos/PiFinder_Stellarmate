+def imu_monitor(shared_state, console_queue, log_queue, fake_imu_command_queue=None):
+    """Entry point used directly (not via imu_pi.py's runtime fallback) on
+    platforms where imu_pi.py fails to *import* at all - adafruit-blinka's
+    `board` module raises at import time on anything main.py doesn't
+    recognize as a Pi (e.g. a plain x86 dev/Control-host machine, see
+    PiFinder_Stellarmate#98) - main.py catches that and imports this module
+    directly instead (see its own `-fh`/`--fakehardware` and IMU-import
+    fallback paths). 2026-09-01: this used to just spin Imu.update() forever
+    without ever publishing anything - see
+    docs/concepts/full_simulation_imu_dead_reckoning.md
+    (PiFinder_Stellarmate) - now mirrors imu_pi.py's own publish loop
+    (calibration-gated shared_state.set_imu()) so Full Simulation's fake IMU
+    behaves the same way regardless of which of the two entry points
+    resolved it.
+    """
     MultiprocLogging.configurer(log_queue)
-    imu = Imu()
