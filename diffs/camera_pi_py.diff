     def set_camera_config(
         self, exposure_time: float, gain: float
     ) -> Tuple[float, float]:
-        # picamera2 supports changing controls on-the-fly without restart.
-        # Setting a manual exposure always disables native auto-exposure, so a
-        # prior `set_exp:native` (daytime align) can't keep overriding it.
-        self.camera.set_controls({"AeEnable": False})
-        self.camera.set_controls({"AnalogueGain": gain})
-        self.camera.set_controls({"ExposureTime": exposure_time})
-
-        # Start camera if it's not already running
-        if not self._camera_started:
-            self.start_camera()
+        # picamera2's "on-the-fly" set_controls() while the camera is
+        # running is NOT reliable on this system: found live 2026-09-26 that
+        # even a single, properly serialized (non-concurrent) live control
+        # change eventually crashes the libcamera IPA proxy on the next
+        # capture or two ("A list of V4L2 controls requires a
+        # ControlInfoMap", FATAL - not merely a race with a concurrent
+        # capture_request(), which self._camera_lock separately guards
+        # against, see its own comment in __init__). A stop()/
+        # set_controls()/start() cycle - the same pattern capture_bias()
+        # already used, and initialize()'s own configure-then-start sequence
+        # - reliably avoided it over repeated verification cycles. Measured
+        # cost: ~50ms, negligible against real exposure times.
+        #
+        # Still guarded by the non-blocking lock: a capture can legitimately
+        # still be in flight (a long exposure, or one wedged in the driver
+        # and merely abandoned - not cancelled - by camera_interface.py's
+        # own capture timeout, whose daemon thread keeps running against the
+        # camera forever). Stopping the camera out from under that thread's
+        # capture_request() would be its own hazard. Skip this cycle instead
+        # when busy - every caller (PID/SNR auto-exposure, manual exposure
+        # changes) re-issues the same target next time, so a skipped update
+        # is picked up a beat later, not lost.
+        if self._camera_lock.acquire(blocking=False):
+            try:
+                if self._camera_started:
+                    self.camera.stop()
+                # Setting a manual exposure always disables native
+                # auto-exposure, so a prior `set_exp:native` (daytime align)
+                # can't keep overriding it.
+                self.camera.set_controls({"AeEnable": False})
+                self.camera.set_controls({"AnalogueGain": gain})
+                self.camera.set_controls({"ExposureTime": exposure_time})
+                self.camera.start()
+                self._camera_started = True
+            finally:
+                self._camera_lock.release()
+        else:
+            logger.debug(
+                "set_camera_config: camera busy (capture in flight) - "
+                "skipping this update, will retry next cycle"
+            )
         return exposure_time, gain
 
